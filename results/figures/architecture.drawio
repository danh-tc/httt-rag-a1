<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="Kiến trúc hệ thống">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="980" background="#FCFCFB" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Kiến trúc hệ thống tìm kiếm hai tầng (mode hybrid_rerank)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- Regions (drawn first so they sit behind the boxes) -->
        <mxCell id="rBackend" value="Backend: FastAPI" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBFAF8;strokeColor=#C3C2B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rTier1" value="TẦNG 1 · Truy xuất ứng viên" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#86B6EF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="120" y="330" width="660" height="390" as="geometry" />
        </mxCell>
        <mxCell id="rPostgres" value="PostgreSQL (ParadeDB)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2EE;strokeColor=#C3C2B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="160" y="375" width="580" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rTier2" value="TẦNG 2 · Xếp hạng lại" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFFB;strokeColor=#9085E9;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="120" y="760" width="660" height="150" as="geometry" />
        </mxCell>

        <!-- Boxes -->
        <mxCell id="frontend" value="&lt;b style=&quot;font-size:15px;color:#0B0B0B&quot;&gt;Frontend (React)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#52514E&quot;&gt;Người dùng nhập câu hỏi, chọn mode&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#898781;strokeWidth=1.5;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="encode" value="&lt;b style=&quot;font-size:15px;color:#0B0B0B&quot;&gt;Mã hóa câu hỏi → vector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#52514E&quot;&gt;e5-base (GPU), dùng cho nhánh ngữ nghĩa&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#898781;strokeWidth=1.5;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="215" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bm25" value="&lt;b style=&quot;font-size:15px;color:#0B0B0B&quot;&gt;BM25 index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#52514E&quot;&gt;pg_search · khớp từ khóa&lt;br&gt;của câu hỏi → top-50&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#898781;strokeWidth=1.5;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="420" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="hnsw" value="&lt;b style=&quot;font-size:15px;color:#0B0B0B&quot;&gt;HNSW index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#52514E&quot;&gt;pgvector · so vector&lt;br&gt;câu hỏi → top-50&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#898781;strokeWidth=1.5;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="420" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rrf" value="&lt;b style=&quot;font-size:15px;color:#0B0B0B&quot;&gt;Gộp RRF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#52514E&quot;&gt;điểm = Σ 1 / (60 + hạng)  →  50 ứng viên&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86B6EF;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="600" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rerank" value="&lt;b style=&quot;font-size:15px;color:#0B0B0B&quot;&gt;Cross-encoder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#52514E&quot;&gt;bge-reranker-v2-m3 (GPU)&lt;br&gt;chấm lại từng cặp (câu hỏi, tài liệu)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9085E9;strokeWidth=1.5;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="800" width="380" height="85" as="geometry" />
        </mxCell>

        <!-- Side notes -->
        <mxCell id="noteRrf" value="Chạy ở backend&lt;br&gt;(Python) hoặc&lt;br&gt;trong SQL&lt;br&gt;(1 truy vấn)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="800" y="600" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="noteRerank" value="Luôn chạy ở&lt;br&gt;service layer,&lt;br&gt;không trong DB" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="800" y="812" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="returnLabel" value="top-10 kết quả + thời gian từng tầng" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#52514E;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="-110" y="470" width="260" height="24" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="eRequest" value="GET /search?q=…&amp;amp;mode=hybrid_rerank" style="endArrow=block;endFill=1;html=1;strokeColor=#898781;strokeWidth=1.5;fontSize=12;fontStyle=2;fontColor=#52514E;labelBackgroundColor=none;align=left;spacingLeft=10;" edge="1" parent="1" source="frontend" target="rBackend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eBm25" style="endArrow=block;endFill=1;html=1;strokeColor=#898781;strokeWidth=1.5;exitX=0.342;exitY=1;entryX=0.87;entryY=0;" edge="1" parent="1" source="encode" target="bm25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eHnsw" style="endArrow=block;endFill=1;html=1;strokeColor=#898781;strokeWidth=1.5;exitX=0.789;exitY=1;entryX=0.348;entryY=0;" edge="1" parent="1" source="encode" target="hnsw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eBm25Rrf" style="endArrow=block;endFill=1;html=1;strokeColor=#898781;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.36;entryY=0;" edge="1" parent="1" source="bm25" target="rrf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eHnswRrf" style="endArrow=block;endFill=1;html=1;strokeColor=#898781;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.64;entryY=0;" edge="1" parent="1" source="hnsw" target="rrf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eRrfNote" style="endArrow=none;html=1;strokeColor=#86B6EF;strokeWidth=1;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="rrf" target="noteRrf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eRerank" value="50 ứng viên + nội dung" style="endArrow=block;endFill=1;html=1;strokeColor=#898781;strokeWidth=1.5;fontSize=12;fontStyle=2;fontColor=#52514E;labelBackgroundColor=none;align=left;spacingLeft=10;" edge="1" parent="1" source="rrf" target="rerank">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eReturn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;strokeColor=#9085E9;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rerank" target="frontend">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="60" y="842" />
              <mxPoint x="60" y="95" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
